{
  "database": {"id": "laudium_post", "name": "Laudium Post"},
  "collections": [
    {
      "id": "public_articles",
      "purpose": "Read-only projection of published articles; never write drafts here.",
      "permissions": ["read(\"any\")"],
      "attributes": {"title": "string(120)", "slug": "string(140)", "excerpt": "string(300)", "body": "string(30000)", "category": "enum[Community,Business,Culture,Sport,Civic]", "author": "string(120)", "status": "enum[Published]", "publishedAt": "datetime", "readTime": "string(30)", "accent": "string(30)", "featured": "boolean"},
      "indexes": [{"key":"articles_status_published","type":"key","attributes":["status","publishedAt"]},{"key":"articles_published_order_id","type":"key","attributes":["publishedAt","$id"]},{"key":"articles_title_search","type":"fulltext","attributes":["title"]},{"key":"articles_excerpt_search","type":"fulltext","attributes":["excerpt"]}]
    },
    {
      "id": "public_ads",
      "purpose": "Read-only projection of approved, currently active listings; contains only the consented public contact projection, never private advertiser/contact source fields.",
      "permissions": ["read(\"any\")"],
      "attributes": {"business": "string(120)", "title": "string(140)", "description": "string(500)", "offer": "string(500)", "category": "string(80)", "location": "string(180)", "serviceArea": "string(180)", "status": "enum[Approved]", "active": "boolean", "startsAt": "datetime", "endsAt": "datetime", "accent": "string(30)", "featured": "boolean", "media": "json", "contacts": "json object (allowlist: phone, whatsapp, email, website, directionsUrl; validated and consented public projection only)", "placements": "string[]", "priority": "integer", "rotationKey": "string(120)"},
      "indexes": [{"key":"ads_live_order","type":"key","attributes":["status","active","startsAt","endsAt"]},{"key":"ads_starts_order_id","type":"key","attributes":["startsAt","$id"]},{"key":"ads_business_search","type":"fulltext","attributes":["business"]},{"key":"ads_title_search","type":"fulltext","attributes":["title"]},{"key":"ads_category_search","type":"fulltext","attributes":["category"]}]
    },
    {
      "id": "public_categories",
      "purpose": "Read-only category labels used by the public UI.",
      "permissions": ["read(\"any\")"],
      "attributes": {"name": "string(80)", "slug": "string(80)", "active": "boolean", "sortOrder": "integer"}
    },
    {
      "id": "editorial_articles",
      "purpose": "Private source records including drafts, schedules and moderation metadata.",
      "permissions": ["read(\"team:editors\")", "create(\"team:editors\")", "update(\"team:editors\")", "delete(\"team:editors\")"],
      "attributes": {"title": "string(120)", "slug": "string(140)", "excerpt": "string(300)", "body": "string(30000)", "category": "string(80)", "author": "string(120)", "status": "enum[Draft,Published,Scheduled,Archived]", "publishedAt": "datetime", "featured": "boolean"}
    },
    {
      "id": "advertiser_records",
      "purpose": "Private advertiser records and approval workflow; never public-read.",
      "permissions": ["read(\"team:editors\")", "create(\"team:editors\")", "update(\"team:editors\")", "delete(\"team:editors\")"],
      "attributes": {"business": "string(120)", "title": "string(140)", "description": "string(500)", "offer": "string(500)", "category": "string(80)", "location": "string(180)", "serviceArea": "string(180)", "phone": "string(40)", "whatsapp": "string(40)", "email": "email", "website": "url", "directionsUrl": "url", "phoneConsent": "boolean", "whatsappConsent": "boolean", "emailConsent": "boolean", "websiteConsent": "boolean", "directionsUrlConsent": "boolean", "status": "enum[Pending,Approved,Archived]", "active": "boolean", "startsAt": "datetime", "endsAt": "datetime", "media": "json", "placements": "string[]", "priority": "integer", "rotationKey": "string(120)"}
    },
    {
      "id": "corrections",
      "permissions": ["create(\"any\")", "read(\"team:editors\")", "update(\"team:editors\")"],
      "attributes": {"articleId": "string(80)", "message": "string(2000)", "email": "email", "status": "enum[Open,Resolved]"}
    },
    {
      "id": "analytics_events",
      "permissions": ["create(\"any\")", "read(\"team:editors\")"],
      "attributes": {"name": "string(80)", "properties": "string(4000)", "occurredAt": "datetime"}
    }
  ],
  "teams": [{"id": "editors", "roles": ["owner", "editor", "contributor"]}],
  "publishing": "A trusted Appwrite Function copies only approved, active, date-live ad records into public_ads. Before writing the projection it applies the explicit public channel allowlist (phone/call, whatsapp, email, website, directionsUrl), validates tel/WhatsApp/mailto/HTTPS schemes, and copies each field only when its matching *Consent boolean is true. public_ads.contacts contains only that sanitized projection, never raw private contact fields or consent flags. The client applies the same allowlist and scheme validation before returning/rendering; client SDKs never read private collections. Never expose API keys in VITE_* variables."
}
