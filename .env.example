# Production is fail-closed. Demo requires BOTH flags below; either missing/false resolves to Appwrite/live.
VITE_CONTENT_MODE=appwrite
VITE_LOCAL_DEMO_MODE=false
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
# These legacy variable names contain the current TablesDB table IDs.
VITE_APPWRITE_ARTICLES_COLLECTION_ID=
VITE_APPWRITE_ADS_COLLECTION_ID=
VITE_APPWRITE_CATEGORIES_COLLECTION_ID=
VITE_APPWRITE_MEDIA_BUCKET_ID=
# Publication-owned WhatsApp number for advertising enquiries (digits only, with country code).
# This is intentionally separate from any advertiser/listing contact details.
VITE_PUBLICATION_WHATSAPP_NUMBER=
# Required in production: HTTPS endpoint/Appwrite Function for durable allow-listed analytics events.
VITE_ANALYTICS_ENDPOINT=
VITE_APPWRITE_STAFF_TEAM_ID=

# Server-only media publication Function (never expose these as VITE_* variables).
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=laudium_post
APPWRITE_MEDIA_BUCKET_ID=laudium_media
APPWRITE_EDITORS_TEAM_ID=editors
APPWRITE_ARTICLE_SOURCE_TABLE_ID=editorial_articles
APPWRITE_ADVERTISER_SOURCE_TABLE_ID=advertiser_records
